# ------------------------------------------------------------
# Dados de entrada
# ------------------------------------------------------------
# As imagens podem ser grandes ou possuir restrições de licença.
# Os arquivos .gitkeep preservam a estrutura dos diretórios.

data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/external/*
!data/external/.gitkeep

# Permite versionar a documentação dos dados.
!data/README.md


# ------------------------------------------------------------
# Resultados gerados pelos experimentos
# ------------------------------------------------------------

outputs/checkpoints/*
!outputs/checkpoints/.gitkeep

outputs/reconstructed/*
!outputs/reconstructed/.gitkeep

outputs/figures/*
!outputs/figures/.gitkeep

outputs/metrics/*
!outputs/metrics/.gitkeep

outputs/tables/*
!outputs/tables/.gitkeep

outputs/logs/*
!outputs/logs/.gitkeep


