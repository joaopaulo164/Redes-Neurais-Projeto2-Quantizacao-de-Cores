# Checkpoints e modelos treinados
# ------------------------------------------------------------

*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.pickle
*.joblib


# ------------------------------------------------------------
# Resultados tabulares gerados
# ------------------------------------------------------------

*.parquet
*.feather

# Arquivos CSV não são ignorados globalmente porque o projeto
# pode possuir metadados pequenos que devam ser versionados.
# Os CSVs experimentais já são ignorados dentro de outputs/.


# ------------------------------------------------------------
# Imagens e figuras
# ------------------------------------------------------------
# Não ignore globalmente *.png, *.jpg ou *.jpeg, pois as imagens
# podem fazer parte da documentação e de report/assets/.
# As saídas experimentais já são ignoradas em outputs/.


# ------------------------------------------------------------
# Relatórios gerados automaticamente
# ------------------------------------------------------------

report/relatorio_gerado.md
report/generated/

# Arquivos auxiliares de LaTeX, caso o relatório seja convertido.
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz

# A pasta report/assets/ não é ignorada: use-a para versionar
# apenas figuras e evidências finais citadas no relatório.


